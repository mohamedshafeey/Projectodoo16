<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Add Extra Field 1 and Extra Field 2 after the Customer field on the Sales Order form -->
        <record id="view_order_form_extra_fields" model="ir.ui.view">
            <field name="name">sale.order.form.extra.fields</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="exta"/>
                    <field name="extra_field_2"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
